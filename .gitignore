__pycache__/
*.py[cod]
*.sqlite3
.venv/
.env
.env.*
!.env.example
# No subir guías reales ni imágenes con datos de clientes
data/*
!data/.gitkeep

# Archivos temporales de Python
__pycache__/
*.pyc
imagenes/
output/

# Catálogos maestros reales (contienen datos privados)
catalogos/empresas.json
catalogos/destinos.json
catalogos/choferes.json
catalogos/vehiculos.json
catalogos/plantas.json
catalogos/clientes.json
catalogos/respaldo_destinos_legado_2026-07-20.json
catalogos/destinos_legado_original_2026-07-21.json
catalogos/rutas.json
resultado_pruebas.txt
.pytest_cache/
.pytest_temp*/
.tmp_atlas_master_context_verify/

# INFRAESTRUCTURA S2.1: fallback local de la raíz portable cuando no hay
# ATLAS_DATA_DIR ni Drive detectado (desarrollo/tests) -- nunca es Drive.
.atlas_local/

# ATLAS IA A2: artefactos reales de experimentos (contienen evidencia real
# de guías -- RUT, chofer, patente) -- el runner y el formato sí se
# versionan, los resultados de cada corrida real no.
experimentos_atlas_ia/resultados/*
!experimentos_atlas_ia/resultados/.gitkeep

# Hallazgo Codex #6 (diff Mobile -> reporte Desktop) -- certificados/
# claves TLS temporales (p. ej. atlas-mobile-cert.pem/atlas-mobile-
# key.pem, del intento directo de HTTPS ya abandonado -- ver
# servidor_mobile.py --cert/--key y Atlas-Conductores-Mobile/src/
# config.js, bloque MOBILE LOGIN REAL) NUNCA deben poder commitearse por
# accidente. NUNCA commitear una clave privada.
*.pem
*.key
*.crt
